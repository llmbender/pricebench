# Findcheap public API — one key covers the /search agent seat and the
# /extract verification layer (https://findcheap.ai/developers/docs)
FINDCHEAP_API_KEY=fc_live_...
# FINDCHEAP_API=https://api.findcheap.ai   # override for staging

# Agent + judge lab keys
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...
PERPLEXITY_API_KEY=pplx-...

# Optional model overrides (defaults are the published lineup)
# GEMINI_AGENT_MODEL=gemini-3.1-pro-preview
# GEMINI_JUDGE_MODEL=gemini-3.5-flash
# GEMINI_MIN_INTERVAL_S=6      # min seconds between Gemini calls (rate limits)
# PPLX_PRESET=high
# FINDCHEAP_COST_PER_SEARCH=0.03   # flat per-search cost for the report's cost rows

# Only needed for source_tasks.py (list-page fetches during task sourcing)
FIRECRAWL_API_KEY=fc-...
